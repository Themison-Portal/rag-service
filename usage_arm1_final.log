INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "How is the study drug stored and prepared?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 40, "section": "5.4 Conditions for Storage and Use", "score": null, "scores": [0.51686984, 0.019946935], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 80, "section": "16.1 Investigator File", "score": 0.027901376, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 39, "section": "5.1 Treatments Administered", "score": null, "scores": [0.01802074, 0.010489091], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 12, "section": "Investigational Medicinal Product (IMP)", "score": 0.0139557095, "scores": null, "had_context": true}], "context_char_count": 7029, "response": "Source: Protocol Ulcerative Colitis.pdf\n\nThe storage and preparation details for the investigational medicinal products (TJ301 and placebo) are as follows:\n\n1. **Storage temperature:** Both placebo and TJ301 are stored at -20 \u00b1 5\u00b0C in a secure location with controlled access at the trial site.\n[Section 5.4 Conditions for Storage and Use \u00b7 p.40]\n\n2. **Thawing and dilution:** Both products are thawed at the pharmacy (or by site personnel who are blind to study randomisation) and diluted in 250 mL 5% (w/v) glucose for infusion. The concentrations used are:\n   - 1.03 mg/mL TJ301 for the 300 mg group\n   - 2.07 mg/mL TJ301 for the 600 mg group\n   - 0 mg/mL TJ301 for the placebo group\n[Section 5.1 Treatments Administered \u00b7 p.39]\n\n3. **Post-reconstitution storage:** Once reconstituted and diluted, the IMP should be stored at 15\u201325\u00b0C and used as soon as possible within 3 hours of preparation.\n[Section 5.4 Conditions for Storage and Use \u00b7 p.40]\n\n4. **Administration volume and infusion time:** An infusion volume of 290 mL is used, and the infusion time is 2 hours.\n[Section 5.4 Conditions for Storage and Use \u00b7 p.40]\n\n5. **Formulation details:** TJ301 is supplied as 15 mg/mL in a solution for injection (25 mM histidine, 200 mM sucrose, 0.1 mg/mL polysorbate 20 in aqueous solution), in 5 mL vials. The placebo is the same solution without TJ301.\n[Section 5.1 Treatments Administered \u00b7 p.39]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 40, "section": "5.4 Conditions for Storage and Use", "exactText": "The storage condition for placebo and TJ301 is -20 \u00b1 5 \u00b0C and thawed at the pharmacy and diluted in 250 mL 5% (w/v) glucose. When reconstituted for infusion, the finally diluted IMPs should be stored at 15-25 \u00b0C and used as soon as possible within 3 hours of preparation.", "bboxes": [[71.99999999999994, 552.7439829101567, 554.76, 404.93497521784855]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 39, "section": "5.1 Treatments Administered", "exactText": "Both placebo and TJ301 should be stored at -20\u00b15\u00b0C and thawed at the site by site personnel (blind to study randomisation) and diluted in 250 mL 5% (w/v) glucose (1.03 mg/mL TJ301 for the 300 mg group, 2.07 mg/mL TJ301 for the 600 mg group and 0 mg/mL TJ301 for the placebo group). The infusion time is 2 hours.", "bboxes": [[71.99999999999994, 459.52798291015654, 201.59999999999994, 448.9749752178488], [71.99999999999997, 689.9039829101564, 523.8, 664.4949752178487]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 12, "section": "Investigational Medicinal Product (IMP)", "exactText": "Both placebo and TJ301 should be stored at -20 \u00b1 5 \u00b0C and thawed at the site by site personnel (blind to study randomisation) and diluted in 250 mL 5% (w/v) glucose. The infusion time is 2 hours.", "bboxes": [[72.0, 529.2239829101562, 552.2400000000001, 473.4549752178485]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.008167233318090439, "query_condensed": false, "embedding_ms": 672.2249579615891, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.5522, 0.526, 0.5181, 0.5178, 0.5168, 0.5098, 0.4978, 0.493, 0.4675, 0.459, 0.459, 0.4466, 0.4409, 0.4379, 0.4371, 0.4342, 0.4307, 0.4277, 0.4184, 0.4168, 0.4168, 0.4116, 0.4111, 0.411, 0.4109, 0.4109, 0.408, 0.4076, 0.4076, 0.4075, 0.4058, 0.4034, 0.4013, 0.4013, 0.4002, 0.3994, 0.3992, 0.3989, 0.397, 0.3967, 0.3952, 0.3944, 0.3937, 0.3931, 0.3917], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5693.167749792337, "hybrid_parallel_ms": 6106.66620824486, "vector_count": 45, "bm25_count": 0, "fused_count": 45, "reranker_enabled": true, "reranker_provider": "cohere", "reranker_ms": 483.4674997255206, "reranker_input_count": 45, "reranker_output_count": 6, "reranker_model": "rerank-english-v3.0", "retrieval_total_ms": 6608.895208220929}, "original_chunk_count": 6, "compression_ms": 0.598750077188015, "compressed_chunk_count": 4, "llm_call_ms": 16340.301666874439, "provider": "anthropic", "model": "claude-sonnet-4-6", "generation_total_ms": 23624.158249702305}}
