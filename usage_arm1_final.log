INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "What are the key inclusion criteria?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 9, "section": "Inclusion Criteria", "score": 0.9825575, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 34, "section": "4.1.1 Inclusion Criteria", "score": null, "scores": [0.97134733, 0.94427973, 0.25423113], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 10, "section": "Inclusion Criteria", "score": null, "scores": [0.962462, 0.35220176], "had_context": true}], "context_char_count": 6219, "response": "Source: Protocol Ulcerative Colitis.pdf\n\nThe key inclusion criteria for the clinical trial evaluating TJ301 in active ulcerative colitis are as follows:\n\n1. Male and female patients 18\u201370 (inclusive) years of age.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n2. Active UC confirmed by colonoscopy with biopsy or flexible sigmoidoscopy with biopsy at Screening, with extending > 15-cm past the anal verge from endoscopy.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n3. Active UC with a full Mayo score \u2265 5 and a rectal bleeding subscore \u2265 1 at screening.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n4. During Day -35 to Day -6 prior to Randomisation, an endoscopy subscore \u2265 2.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n5. Treated with conventional non-biological UC therapy: with corticosteroids stable for at least 2 weeks prior to Randomization at no more than 20 mg prednisone (or equivalent), and/or with medications containing 5-aminosalicylates (5-ASA) at no less than 2 g 5-ASA per day for at least 3 months and stable for at least 4 weeks prior to Randomization, and/or with azathioprine (AZA) at no less than 1.5 mg/kg/day or mercaptopurine (6-MP) at no less than 0.75 mg/kg/day for at least 6 months and stable for at least 6 weeks prior to Randomization.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n6. A female subject has been sterilized or has been menopausal, or the subject has no pregnancy plan during the trial and voluntarily adopts effective contraceptive measures.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n7. The patient is able and willing to comply with the requirements of this trial protocol.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n8. The subject should be able to read and write to understand and fill out Patient Diary.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n9. Voluntarily signed Informed Consent obtained before any trial-related procedures are performed.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 34, "section": "4.1.1 Inclusion Criteria", "exactText": "A subject will be eligible for inclusion in this study only if all of the following criteria apply:\n1. Male and female patients 18-70 (inclusive) years of age.\n2. Active UC confirmed by colonoscopy with biopsy or flexible sigmoidoscopy with biopsy at Screening, with extending > 15-cm past the anal verge from endoscopy.\n3. Active UC with a full Mayo score \u2265 5 and a rectal bleeding subscore \u22651 at screening.\n4. During Day -35 to Day-6 prior to Randomisation, an endoscopy subscore \u22652 .\n5. Treated with conventional non-biological UC therapy: with corticosteroids stable for at least 2 weeks prior to Randomization at no more than 20 mg prednisone (or equivalent), and/or with medications containing 5-aminosalicylates (5-ASA) at no less than 2 g 5-ASA per day for at least 3 months and stable for at least 4 weeks prior to Randomization, and/or with azathioprine (AZA) at no less than 1.5 mg/kg/day or mercaptopurine (6-MP) at no less than 0.75 mg/kg/day for at least 6 months and stable for at least 6 weeks prior to Randomization.\n6. A female subject has been sterilized or has been menopausal, or the subject has no pregnancy plan during the trial and voluntarily adopts effective contraceptive measures.\n7. The patient is able and willing to comply with the requirements of this trial protocol.\n8. The subject should be able to read and write to understand and fill out Patient Diary.\n9. Voluntarily signed Informed Consent obtained before any trial-related procedures are performed.", "bboxes": [[71.99999999999994, 612.6239829101564, 521.16, 602.3349752178488], [72.00000000000006, 489.6239829101564, 551.7600000000001, 403.37497521784866], [72.0, 251.66398291015628, 520.5600000000001, 241.3749752178486]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.001166015863418579, "query_condensed": false, "embedding_ms": 871.9067499041557, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.5598, 0.5541, 0.5497, 0.545, 0.5431, 0.5397, 0.5378, 0.5348, 0.5311, 0.5265, 0.499, 0.491, 0.4858, 0.485, 0.4834, 0.4742, 0.4726, 0.4566, 0.4377, 0.4295, 0.4237, 0.4199, 0.4189, 0.4174, 0.4161, 0.4154, 0.4119, 0.4099, 0.4095, 0.409, 0.4077, 0.4064, 0.4058, 0.4029, 0.4012, 0.3988, 0.3987, 0.3985, 0.3984, 0.398, 0.3968, 0.3967, 0.3965, 0.3952, 0.3951], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5772.368041798472, "hybrid_parallel_ms": 6181.359124835581, "vector_count": 45, "bm25_count": 0, "fused_count": 45, "reranker_enabled": true, "reranker_provider": "cohere", "reranker_ms": 375.8984999731183, "reranker_input_count": 45, "reranker_output_count": 6, "reranker_model": "rerank-