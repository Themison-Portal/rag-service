INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "What is the planned sample size and statistical power?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 12, "section": "Sample Size", "score": 0.9383503, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 66, "section": "9.1 Determination of Sample Size", "score": null, "scores": [0.9328214, 0.03676947], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 29, "section": "3.2 Planned Number of Patients", "score": 0.07935289, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 67, "section": "9.6.1 General Considerations", "score": 0.021698097, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 14, "section": "Data Analyses", "score": 0.02132808, "scores": null, "had_context": true}], "context_char_count": 5525, "response": "Source: Protocol Ulcerative Colitis.pdf\n\nThe planned sample size and statistical power are as follows:\n\n1. **Total Enrollment:** A total of 90 patients with active UC will be enrolled competitively across approximately 25\u201330 investigational sites globally, randomised equally into three arms (two dose levels of TJ301 and placebo), accounting for an approximately 20% dropout rate.\n[Section 9.1 Determination of Sample Size \u00b7 p.66]\n\n2. **Evaluable Sample Size:** N=72 evaluable patients (n=24 per treatment/placebo arm) are targeted.\n[Section 9.1 Determination of Sample Size \u00b7 p.66]\n\n3. **Primary Power Calculation (83% power):** The trial is expected to achieve 83% power of detecting a trend (p<0.05, one-sided) if the true remission rate difference at Week 12 between the placebo and highest dose group (600 mg Q2W) is 30% (10% for placebo vs. 40% for highest dose), using Pearson's chi-square test without continuity correction.\n[Section 9.1 Determination of Sample Size \u00b7 p.66]\n\n4. **Secondary Power Calculation (70% power):** The trial also has 70% power to reach a statistically significant result (p<0.05, one-sided) if the remission rate difference between placebo and the combined treatment groups (300 mg Q2W and 600 mg Q2W combined) is 20% (10% vs. 30%).\n[Section 9.1 Determination of Sample Size \u00b7 p.66]\n\n5. **Exploratory Nature:** This is a proof-of-concept trial not aimed at confirming primary efficacy but rather at exploring preliminary indications of efficacy and safety to inform a decision about proceeding into full development. Statistical testing will be performed at both the one-sided 20% and one-sided 5% significance levels.\n[Section 9.1 Determination of Sample Size \u00b7 p.67]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 66, "section": "9.1 Determination of Sample Size", "exactText": "A sample size of N=72 (n=24 per treatment/placebo arm) patients is expected to achieve a power of 83 % of detecting a trend (p< 0.05, one-sided) if the true remission rate difference (at Week 12) between the placebo and highest dose groups (600 mg Q2W) is 30% (10% for the placebo and 40% for the highest dose) using Pearson's chi-square test without continuity correction. The trial also has 70 % power to reach a statistically significant result (p<0.05, one-sided) in case the remission rate difference between placebo and treatment (300 mg Q2W and 600 mg Q2W combined together) is 20% (10% vs 30%). Considering the dropout rate of approximately 20 %, a total of 90 patients will be enrolled competitively.", "bboxes": [[72.00000000000006, 583.8239829101564, 554.16, 467.33497521784864], [72.0, 671.7839829101564, 552.4800000000001, 600.7749752178487]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 67, "section": "9.1 Determination of Sample Size", "exactText": "This is a proof-of-concept trial not aimed at confirming evidence of primary efficacy but rather at exploring preliminary indications of efficacy (not per se restricted to primary only) and safety with the aim of informing a decision about proceeding into full development.", "bboxes": [[71.9999999999996, 375.98398291015644, 549.8399999999996, 320.21497521784863]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 29, "section": "3.2 Planned Number of Patients", "exactText": "In total, 90 patients with active UC at approximately 25-30 investigational sites globally will be enrolled competitively and randomised equally into three arms with TJ301 (two dose levels) or placebo.", "bboxes": [[72.0, 653.5439829101564, 534.48, 612.8949752178487]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 67, "section": "9.6.1 General Considerations", "exactText": "Due to exploratory nature of this proof-of-concept trial, statistical testing will be performed both at the onesided 20% and the onesided 5% level.", "bboxes": [[71.9999999999996, 375.98398291015644, 549.8399999999996, 320.21497521784863]], "relevance": "medium"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.006292015314102173, "query_condensed": false, "embedding_ms": 746.2045419961214, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.5447, 0.5325, 0.425, 0.4235, 0.4216, 0.4193, 0.4173, 0.4148, 0.3961, 0.383, 0.3648, 0.3638, 0.3613, 0.3602, 0.3591, 0.3572, 0.3507, 0.3501, 0.3461, 0.3384, 0.3352, 0.3326, 0.3298, 0.327, 0.3266, 0.3259, 0.322, 0.3196, 0.3194, 0.3192, 0.3183, 0.3157, 0.3115, 0.3113, 0.3097, 0.3084, 0.3053, 0.3048, 0.3042, 0.302, 0.301, 0.3009, 0.299, 0.299, 0.2988], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5488.900082651526, "hybrid_parallel_ms": 5897.340042050928, "vector_count": 45, "bm25_count": 0, "fused_count": 45, "reranker_enabled": true, "reranker_provider": "cohere", "reranker_ms": 346.74145793542266, "reranker_input_count": 45, "reranker_output_count": 6, "reranker_model": "rerank-english-v3.0", "retrieval_total_ms": 6263.313541654497}, "original_chunk_count": 6, "compression_ms": 0.3655422478914261, "compressed_chunk_count": 5, "llm_call_ms": 15970.89962521568, "provider": "anthropic", "model": "claude-sonnet-4-6", "generation_total_ms": 22982.99050005153}}
