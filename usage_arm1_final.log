INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "What is the definition of clinical and endoscopic remission?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 68, "section": "9.6.2 Primary Endpoint", "score": 0.99790895, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 24, "section": "Primary Endpoints", "score": null, "scores": [0.997783, 0.9801293], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 53, "section": "7.1.1 Clinical and Endoscopic Disease Activity (Mayo Score)", "score": 0.9959299, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 30, "section": "3.4.2 Selection of Endpoints", "score": 0.9928509, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 7, "section": "Secondary Endpoints", "score": 0.97724086, "scores": null, "had_context": true}], "context_char_count": 7295, "response": "Source: Protocol Ulcerative Colitis.pdf\n\nClinical and endoscopic remission is defined as follows:\n\n1. A full Mayo score \u2264 2, with no individual subscore > 1, and a rectal bleeding subscore = 0, assessed at Week 12.\n[Section 3.4.2 Selection of Endpoints \u00b7 p.30]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 30, "section": "3.4.2 Selection of Endpoints", "exactText": "The prospectively defined primary efficacy endpoint will be a binary endpoint of clinical and endoscopic remission at Week 12, defined as a full Mayo score \u22642, no individual subscore >1 , and rectal bleeding subscore = 0.", "bboxes": [[71.99999999999994, 664.2239829101562, 549.4800000000001, 517.3749752178485]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 53, "section": "7.1.1 Clinical and Endoscopic Disease Activity (Mayo Score)", "exactText": "The prospectively defined primary efficacy variable of clinical and endoscopic remission (defined as a full Mayo score \u22642, no individual subscore >1, rectal bleeding subscore = 0 ), will be used and is in accordance with guidelines and literature.", "bboxes": [[72.00000000000011, 500.42398291015644, 547.3199999999999, 459.7749752178487]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 68, "section": "9.6.2 Primary Endpoint", "exactText": "The primary efficacy endpoint is clinical and endoscopic remission (defined as a full Mayo score \u22642, no individual subscore >1, rectal bleeding subscore = 0) at Week 12 in the ITT population.", "bboxes": [[71.99999999999997, 721.7039829101564, 558.8399999999996, 605.2149752178486]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 24, "section": "Primary Endpoints", "exactText": "Clinical and endoscopic remission at Week 12, defined as a full Mayo score \u2264 2, no individual subscore >1, rectal bleeding subscore = 0.", "bboxes": [[89.88000000000005, 432.8399829101563, 509.16, 406.8549752178486], [89.88, 331.19998291015634, 550.4399999999999, 290.0949752178486]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.0010421499609947205, "query_condensed": false, "embedding_ms": 717.4305408261716, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 43, "confidence_filter_kept_count": 43, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.5152, 0.4329, 0.5896, 0.5444, 0.5416, 0.5383, 0.5371, 0.5186, 0.5029, 0.4888, 0.4885, 0.4869, 0.4802, 0.4769, 0.4677, 0.4611, 0.4551, 0.4536, 0.451, 0.4456, 0.4447, 0.4403, 0.4378, 0.435, 0.4204, 0.4169, 0.4132, 0.4127, 0.4083, 0.407, 0.4069, 0.4064, 0.406, 0.4057, 0.4057, 0.4047, 0.4035, 0.4013, 0.4012, 0.401