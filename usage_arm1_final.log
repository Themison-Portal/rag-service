ety Review committee (SRC) will be established. The SRC is an expert advisory group commissioned and charged with the responsibility of evaluating, primarily, cumulative safety data at regular intervals.", "bboxes": [[72.0, 579.2639829101564, 555.24, 523.3749752178487]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 93, "section": "Appendix 4 - Summary of Changes for Version 1.1", "exactText": "3.3, 3 = It is more appropriate to use SRC rather than DSMC as the name of the committee, since the purpose of the committee is to review safety data.", "bboxes": [[52.683868408203125, 495.55684661865234, 771.1757202148438, 129.38385009765625]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.0009997747838497162, "query_condensed": false, "embedding_ms": 972.8404171764851, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.5275, 0.5154, 0.502, 0.4999, 0.4997, 0.4949, 0.4931, 0.4862, 0.4847, 0.4824, 0.472, 0.4715, 0.4698, 0.4686, 0.4679, 0.4679, 0.4667, 0.4646, 0.4639, 0.4616, 0.4612, 0.4599, 0.4591, 0.4588, 0.4585, 0.4581, 0.4571, 0.4563, 0.4561, 0.4553, 0.4548, 0.4538, 0.4519, 0.4511, 0.4494, 0.4475, 0.4467, 0.4465, 0.4442, 0.444, 0.4417, 0.4416, 0.4388, 0.4387, 0.437], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5506.256207823753, "hybrid_parallel_ms": 5913.720374926925, "vector_count": 45, "bm25_count": 0, "fused_count": 45, "reranker_enabled": true, "reranker_provider": "cohere", "reranker_ms": 419.6156249381602, "reranker_input_count": 45, "reranker_output_coun