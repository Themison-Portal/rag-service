INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "What are the key inclusion criteria?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 9, "section": "Inclusion Criteria", "score": 0.9825575, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 34, "section": "4.1.1 Inclusion Criteria", "score": null, "scores": [0.97134733, 0.94427973, 0.25423113], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 10, "section": "Inclusion Criteria", "score": null, "scores": [0.962462, 0.35220176], "had_context": true}], "context_char_count": 6149, "response": "Source: Protocol Ulcerative Colitis\n\nAll of the following inclusion criteria must apply:\n\n1. Male and female patients 18-70 (inclusive) years of age.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n2. Active UC confirmed by colonoscopy with biopsy or flexible sigmoidoscopy with biopsy at Screening, with extending > 15-cm past the anal verge from endoscopy.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n3. Active UC with a full Mayo score \u2265 5 and a rectal bleeding subscore \u22651 at screening.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n4. During Day -35 to Day-6 prior to Randomisation, an endoscopy subscore \u22652 .\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n5. Treated with conventional non-biological UC therapy: with corticosteroids stable for at least 2 weeks prior to Randomization at no more than 20 mg prednisone (or equivalent), and/or with medications containing 5-aminosalicylates (5-ASA) at no less than 2 g 5-ASA per day for at least 3 months and stable for at least 4 weeks prior to Randomization, and/or with azathioprine (AZA) at no less than 1.5 mg/kg/day or mercaptopurine (6-MP) at no less than 0.75 mg/kg/day for at least 6 months and stable for at least 6 weeks prior to Randomization.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n6. A female subject has been sterilized or has been menopausal, or the subject has no pregnancy plan during the trial and voluntarily adopts effective contraceptive measures.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n7. The patient is able and willing to comply with the requirements of this trial protocol.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n8. The subject should be able to read and write to understand and fill out Patient Diary.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]\n\n9. Voluntarily signed Informed Consent obtained before any trial-related procedures are performed.\n[Section 4.1.1 Inclusion Criteria \u00b7 p.34]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 34, "section": "4.1.1 Inclusion Criteria", "exactText": "A subject will be eligible for inclusion in this study only if all of the following criteria apply:\n1. Male and female patients 18-70 (inclusive) years of age.\n2. Active UC confirmed by colonoscopy with biopsy or flexible sigmoidoscopy with biopsy at Screening, with extending > 15-cm past the anal verge from endoscopy.\n3. Active UC with a full Mayo score \u2265 5 and a rectal bleeding subscore \u22651 at screening.\n4. During Day -35 to Day-6 prior to Randomisation, an endoscopy subscore \u22652 .\n5. Treated with conventional non-biological UC therapy: with corticosteroids stable for at least 2 weeks prior to Randomization at no more than 20 mg prednisone (or equivalent), and/or with medications containing 5-aminosalicylates (5-ASA) at no less than 2 g 5-ASA per day for at least 3 months and stable for at least 4 weeks prior to Randomization, and/or with azathioprine (AZA) at no less than 1.5 mg/kg/day or mercaptopurine (6-MP) at no less than 0.75 mg/kg/day for at least 6 months and stable for at least 6 weeks prior to Randomization.\n6. A female subject has been sterilized or has been menopausal, or the subject has no pregnancy plan during the trial and voluntarily adopts effective contraceptive measures.\n7. The patient is able and willing to comply with the requirements of this trial protocol.\n8. The subject should be able to read and write to understand and fill out Patient Diary.\n9. Voluntarily signed Informed Consent obtained before any trial-related procedures are performed.", "bboxes": [[71.99999999999994, 612.6239829101564, 521.16, 602.3349752178488], [72.00000000000006, 489.6239829101564, 551.7600000000001, 403.37497521784866], [72.0, 251.66398291015628, 520.5600000000001, 241.3749752178486]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.0029173679649829865, "query_condensed": false, "embedding_ms": 645.7351250573993, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.5587, 0.5404, 0.538, 0.5354, 0.5329, 0.5312, 0.5298, 0.5265, 0.5194, 0.5189, 0.4982, 0.48, 0.4744, 0.4729, 0.471, 0.452, 0.4414, 0.4381, 0.435, 0.4311, 0.4264, 0.4198, 0.4185, 0.4163, 0.4145, 0.4139, 0.4124, 0.4121, 0.4095, 0.4088, 0.4076, 0.4061, 0.4052, 0.4046, 0.4034, 0.4013, 0.4001, 0.3997, 0.3988, 0.3979, 0.3952, 0.3937, 0.3934, 0.3924, 0.3901], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5689.724541734904, "hybrid_parallel_ms": 6102.429666090757, "vector_count": 45, "bm25_count": 0, "fused_count": 45, "reranker_enabled": true, "reranker_provider": "cohere", "reranker_ms": 352.13574999943376, "reranker_input_count": 45, "reranker_output_count": 6, "reranker_model": "rerank-english-v3.0", "retrieval_total_ms": 6471.450833138078}, "original_ch