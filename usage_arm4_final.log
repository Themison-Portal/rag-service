INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "(1) How is the drug dosed?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 31, "section": "3.4.4 Selection of Doses in the Trial", "score": 0.19744445, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 30, "section": "3.4.4 Selection of Doses in the Trial", "score": null, "scores": [0.058776557, 0.058776557], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 39, "section": "5.1 Treatments Administered", "score": null, "scores": [0.041930523, 0.027376488], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 32, "section": "3.4.4 Selection of Doses in the Trial", "score": 0.016529556, "scores": null, "had_context": true}], "context_char_count": 6862, "response": "Source: Protocol Ulcerative Colitis\n\nTJ301 is administered as an intravenous infusion. The trial uses two active-dose groups, 300 mg and 600 mg, plus placebo. Both placebo and TJ301 are thawed by site personnel blinded to randomization and diluted in 250 mL of 5% (w/v) glucose. The resulting TJ301 concentrations are 1.03 mg/mL for the 300 mg group and 2.07 mg/mL for the 600 mg group; placebo is 0 mg/mL. Infusion time is 2 hours.\n[Section 5.1 Treatments Administered \u00b7 p.39]\n\nThe selected 300 mg and 600 mg doses are intended to provide exposure above the theoretical full-target-saturation threshold of 1 \u00b5g/mL at trough.\n[Section 3.4.4 Selection of Doses in the Trial \u00b7 p.32]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 39, "section": "5.1 Treatments Administered", "exactText": "Both placebo and TJ301 should be stored at -20 \u00b1 5\u00b0C and thawed at the site by site personnel (blind to study randomisation) and diluted in  250 mL 5% (w/v) glucose (1.03 mg/mL TJ301 for the 300 mg group, 2.07 mg/mL TJ301 for the 600 mg group and 0 mg/mL TJ301 for the placebo group ). The infusion time is 2 hours.", "bboxes": [[71.99999999999997, 689.9039829101564, 523.8, 664.4949752178487], [71.99999999999994, 459.52798291015654, 201.59999999999994, 448.9749752178488]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 32, "section": "3.4.4 Selection of Doses in the Trial", "exactText": "The two doses selected are within the range of doses investigated in phase 1 with dose proportionality in systemic exposure, and with no evident safety signals. The two doses are selected to give exposure above (300 and 600 mg) full target saturation (expected at the theoretical threshold of 1 \u00b5g/mL at trough).", "bboxes": [[71.99999999999994, 422.7839829101563, 552.8399999999997, 336.6549752178485]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.0007920898497104645, "query_condensed": false, "embedding_ms": 917.9562078788877, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 47, "confidence_filter_kept_count": 47, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.4838, 0.4496, 0.4312, 0.4307, 0.4307, 0.4276, 0.4266, 0.4254, 0.4219, 0.4208, 0.4146, 0.4113, 0.4107, 0.4097, 0.4091, 0.4078, 0.4065, 0.4057, 0.405, 0.4026, 0.3995, 0.3983, 0.3979, 0.3954, 0.3949, 0.3902, 0.3897, 0.389, 0.3886, 0.386, 0.3859, 0.3855, 0.3853, 0.3815, 0.3812, 0.3804, 0.3792, 0.3789, 0.3778, 0.3776, 0.377, 0.3763, 0.3733, 0.3705, 0.3702], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [1.0, 0.0], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5461.258000228554, "hybrid_parallel_ms": 5872.394208330661, "vector_count": 45, "bm25_count": 2, "fused_count