INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "What is the molecular mechanism of action of TJ301?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 23, "section": "1.1 Background", "score": 0.9851576, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 29, "section": "3.4.1 Trial Design", "score": 0.9722044, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 22, "section": "1.1 Background", "score": 0.9313377, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 6, "section": "Secondary Objectives", "score": 0.7192851, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 96, "section": "Appendix 4 - Summary of Changes for Version 1.1", "score": 0.692538, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 1, "section": "A Phase II, Randomized, Double-blind, Placebo-controlled Study to Evaluate the Safety and Efficacy of TJ301 (FE 999301) Administered Intravenously in Patients with Active Ulcerative Colitis", "score": 0.6772606, "scores": null, "had_context": true}], "context_char_count": 7510, "response": "Source: Protocol Ulcerative Colitis\n\nTJ301 (olamkicept) is a first-in-class selective IL-6 trans-signalling inhibitor. It acts as an IL-6/soluble IL-6 receptor (sIL-6R) complex trap, formed from two complete extracellular domains of gp130 dimerised through fusion to the Fc region of human IgG1. TJ301 targets and neutralises the IL-6/sIL-6R complex, thereby inhibiting IL-6 trans-signalling without interacting with free IL-6 or IL-6R individually.\n[Section 1.1 Background \u00b7 p.22]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 22, "section": "1.1 Background", "exactText": "TJ301 (FE 999301, Olamkicept (proposed INN)) is a first-in-class, selective IL-6 trans-signalling inhibitor and anti-inflammatory biologic that is under development for the treatment of UC and Crohn's disease. TJ301 is a selective IL-6/sIL-6R complex trap consisting of two complete extracellular domains of gp130, the common signal transducer of IL-6-type cytokines, dimerised by", "bboxes": [[72.00000000000006, 229.82398291015625, 551.3999999999997, 174.05497521784855]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 23, "section": "1.1 Background", "exactText": "fusion to the fragment crystallisable region (Fc region) of human immunoglobulin G1 (IgG1). TJ301 targets and neutralises the IL-6/sIL-6R complex thereby inhibiting the trans -signalling pathway, without any interaction with either IL-6 or IL-6R individually, which is different from other anti-IL6 or anti-IL6R products in development to block IL-6 two signaling pathways.", "bboxes": [[71.99999999999989, 738.5039829101562, 553.0799999999999, 652.3749752178485]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": false, "condense_ms": 0.0006663613021373749, "query_condensed": false, "embedding_ms": 686.4765826612711, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 44, "confidence_filter_kept_count": 44, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.616, 0.6746, 0.66, 0.6478, 0.6445, 0.6196, 0.6166, 0.6153, 0.6085, 0.6046, 0.603, 0.5995, 0.5975, 0.5972, 0.5938, 0.5922, 0.591, 0.5808, 0.5783, 0.5783, 0.5764, 0.5755, 0.5678, 0.5669, 0.5658, 0.5658, 0.5646, 0.5641, 0.559, 0.5577, 0.5503, 0.5495, 0.5493, 0.5475, 0.5448, 0.5447, 0.5415, 0.5387, 0.5372, 0.5369, 0.5288, 0.5286, 0.5244, 0.5242], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid