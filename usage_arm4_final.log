INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "What is the dosing schedule of the study drug?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 68, "section": "9.7 Extent of Exposure and Treatment Compliance", "score": 0.65555656, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 32, "section": "3.4.5 Selection and Timing of Dose for Each Patient", "score": 0.31320965, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 31, "section": "3.4.4 Selection of Doses in the Trial", "score": 0.3106944, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 9, "section": "Study Flowchart", "score": null, "scores": [0.22746934, 0.13488984], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 45, "section": "Table 1 Time and Events Schedule", "score": 0.14342749, "scores": null, "had_context": true}], "context_char_count": 6091, "response": "Source: Protocol Ulcerative Colitis\n\nDuring the 12-week Treatment Period, TJ301 is administered as fixed-dose infusions every 2 weeks by trial personnel at the trial site, for up to 6 total doses. The trial evaluates 75 mg, 300 mg, and 600 mg dose levels administered every other week; the maximum regimen is 600 mg every 2 weeks for 12 consecutive weeks.\n[Section 3.4.5 Selection and Timing of Dose for Each Patient \u00b7 p.32]\n\nThe 75 mg dose every other week is anticipated to suppress the second-messenger signal to baseline for at least 1 week. The 300 mg and 600 mg doses every other week are anticipated to suppress IL-6/sIL-6R STAT-3 activation to baseline, with expected trough levels above 1 \u00b5g/mL.\n[Section 3.4.4 Selection of Doses in the Trial \u00b7 p.31]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 32, "section": "3.4.5 Selection and Timing of Dose for Each Patient", "exactText": "During the 12-week Treatment Period, dosing will be infusions every 2 weeks, as administered by trial personnel at the trial site. Dosing is fixed-dose throughout the trial. In this study, TJ301 will be administered at up to 600 mg every two weeks for 12 consecutive weeks (6 doses totally).", "bboxes": [[72.0, 302.9039829101562, 546.12, 277.4949752178485]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 31, "section": "3.4.4 Selection of Doses in the Trial", "exactText": "The 75 mg dose every other week is, according to simulations, anticipated to suppress the second messenger signal to baseline level for a duration of at least one week... Both the 300 mg and 600 mg dose administered every other week are anticipated to suppress the activation of the IL-6/sIL-6R second messenger signal STAT-3 to baseline, as the trough levels are expected to be >1 \u00b5g/mL.", "bboxes": [[71.9999999999996, 399.0239829101561, 549.1199999999995, 297.65497521784835]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.003125052899122238, "query_condensed": false, "embedding_ms": 886.3522089086473, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.618, 0.559, 0.5577, 0.5356, 0.5331, 0.5303, 0.5274, 0.5251, 0.5223, 0.5167, 0.5144, 0.5142, 0.5103, 0.5103, 0.5081, 0.5056, 0.5045, 0.4987, 0.4974, 0.4959, 0.4952, 0.4949, 0.4916, 0.4882, 0.4861, 0.4828, 0.4825, 0.4823, 0.4814, 0.4813, 0.4812, 0.4805, 0.4805, 0.4803, 0.4783, 0.476, 0.4759, 0.4741, 0.4729, 0.4713, 0.4669, 0.4669, 0.4667, 0.4654, 0.4635], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_on