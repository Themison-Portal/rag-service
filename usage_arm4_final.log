INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "How is the study drug stored and prepared?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 40, "section": "5.4 Conditions for Storage and Use", "score": null, "scores": [0.51686984, 0.019946935], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 80, "section": "16.1 Investigator File", "score": 0.027901376, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 39, "section": "5.1 Treatments Administered", "score": null, "scores": [0.01802074, 0.010489091], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 12, "section": "Investigational Medicinal Product (IMP)", "score": 0.0139557095, "scores": null, "had_context": true}], "context_char_count": 7129, "response": "Source: Protocol Ulcerative Colitis\n\nBoth TJ301 and placebo are stored at \u221220 \u00b1 5 \u00b0C in a secure, access-controlled location at the trial site. They are thawed at the pharmacy/site by personnel blinded to study randomisation and diluted in 250 mL of 5% (w/v) glucose. The resulting TJ301 concentrations are 1.03 mg/mL for the 300 mg group and 2.07 mg/mL for the 600 mg group; placebo contains 0 mg/mL TJ301.\n[Section 5.1 Treatments Administered \u00b7 p.39]\n\nAfter reconstitution/dilution for infusion, the IMP should be kept at 15\u201325 \u00b0C and used as soon as possible, within 3 hours of preparation.\n[Section 5.4 Conditions for Storage and Use \u00b7 p.40]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 39, "section": "5.1 Treatments Administered", "exactText": "Both placebo and TJ301 should be stored at -20 \u00b1 5\u00b0C and thawed at the site by site personnel (blind to study randomisation) and diluted in 250 mL 5% (w/v) glucose (1.03 mg/mL TJ301 for the 300 mg group, 2.07 mg/mL TJ301 for the 600 mg group and 0 mg/mL TJ301 for the placebo group ).", "bboxes": [[71.99999999999994, 459.52798291015654, 201.59999999999994, 448.9749752178488], [71.99999999999997, 689.9039829101564, 523.8, 664.4949752178487]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 40, "section": "5.4 Conditions for Storage and Use", "exactText": "The Investigator will ensure that all medicinal products will be stored at the trial sites in appropriate conditions in a secure location with controlled access. The storage condition for placebo and TJ301 is -20 \u00b1 5 \u00b0C and thawed at the pharmacy and diluted in 250 mL 5% (w/v) glucose . When reconstituted for infusion, the finally diluted IMPs should be stored at 15-25 \u00b0C and used as soon as possible within 3 hours of preparation.", "bboxes": [[71.99999999999994, 552.7439829101567, 554.76, 404.93497521784855], [72.0, 662.6639829101564, 532.92, 638.5749752178488]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.006041955202817917, "query_condensed": false, "embedding_ms": 889.507541898638, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.5436, 0.5313, 0.5158, 0.5058, 0.5042, 0.501, 0.4975, 0.4941, 0.4707, 0.4538, 0.4523, 0.4485, 0.4456, 0.4428, 0.4428, 0.4417, 0.4381, 0.4369, 0.4298, 0.4238, 0.4222, 0.4212, 0.4157, 0.4147, 0.4116, 0.4085, 0.4076, 0.406, 0.4057, 0.4045, 0.4011, 0.3959, 0.3956, 0.394, 0.3927, 0.3922, 0.3899, 0.3898, 0.3868, 0.3858, 0.3851, 0.3849, 0.3848, 0.383, 0.3814], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_sear