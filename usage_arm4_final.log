munosuppressive drugs)) assigned to 3 groups (1:1:1) to receive 600mg TJ301 biweekly (Q2W), 300mg TJ301 Q2W or placebo Q2W.. 3.1.2, also in Synopsis, 4.2.2 and 9.6.2, 2 = 90 patients will be centrally, dynamically, randomly assigned to 3 groups (1:1:1) to receive 600mg TJ301 biweekly (Q2W), 300mg TJ301 Q2W or placebo Q2W. Randomisation will be stratified by prior corticosteroids treatment (yes/no) and consent to participate in PK substudy (yes/no).", "bboxes": [[52.59044647216797, 495.76949310302734, 771.7723999023438, 121.96722412109375]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.0007920898497104645, "query_condensed": false, "embedding_ms": 748.030707705766, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 46, "confidence_filter_kept_count": 46, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.6436, 0.5895, 0.5554, 0.5545, 0.546, 0.541, 0.5322, 0.5313, 0.5289, 0.5253, 0.5218, 0.5083, 0.5055, 0.5035, 0.5032, 0.4998, 0.4975, 0.4975, 0.4971, 0.4919, 0.4856, 0.4837, 0.4793, 0.4772, 0.4759, 0.472, 0.4705, 0.4663, 0.4662, 0.4639, 0.4604, 0.4584, 0.4583, 0.4571, 0.4564, 0.4523, 0.4483, 0.4482, 0.4401, 0.4382, 0.4371, 0.4364, 0.4348, 0.4347, 0.4339], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [0.0], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5664.708666969091, "hybrid_parallel_ms": 6080.236333888024, "vector_count": 45, "bm25_count": 1, "fused_count": 46, "reranker_enabled": true, "reranker_provider": "cohere", "reranker_ms": 460.5555417947471, "reranker_input_count": 46, "reranker_output_count": 6, "reranker_model": "rerank-english-v3.0", "retrieval_total_ms": 6557.344625238329}, "original_chunk_count": 6, "