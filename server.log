2026-07-30 20:54:40,924 - rag_service.services.generation_service - INFO - {"event": "rag_query_trace", "query": "What safety analyses are planned?", "system_prompt_version": "a0b9615a", "retrieved_chunks": [{"title": "Protocol_Ulcerative Colitis.pdf", "page": 67, "section": "9.4.4 Safety Analysis Set", "score": 0.95869267, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 13, "section": "Data Analyses", "score": 0.95806944, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 68, "section": "9.8.1 General Considerations", "score": 0.85573065, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 14, "section": "Data Analyses", "score": null, "scores": [0.051082738, 0.013325147]}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 16, "section": "Protocol No.: CTJ301UC201", "score": 0.01450358, "scores": null}], "context_char_count": 2703, "response": "The following safety analyses are planned for the study:\n\n**1. Descriptive Summaries by Treatment Group**\nSafety analyses will be summarized descriptively by treatment groups. Importantly, **no statistical testing for comparison of treatment groups will be performed for safety variables** (Protocol_Ulcerative Colitis.pdf, p. 13; p. 68).\n\n**2. Safety Analysis Set Definition**\nThe Safety Analysis Set includes **all randomised patients who received at least one dose of IMP**, with treatment assignment according to actual treatment received (Protocol_Ulcerative Colitis.pdf, p. 67).\n\n**3. Safety Parameters Evaluated**\nSafety parameters will be evaluated for the safety analysis data set and will include (Protocol_Ulcerative Colitis.pdf, p. 68):\n- Adverse events\n- Concomitant medications\n- Vital signs\n- Clinical laboratory test values\n- 12-lead ECG\n\n**4. Baseline Definition**\nFor safety data, **Baseline is defined as the last observed value collected prior to the start of treatment** (Protocol_Ulcerative Colitis.pdf, p. 68).\n\n**5. Data Outputs**\nComplete data listings and summary tables will be created for all safety information (Protocol_Ulcerative Colitis.pdf, p. 68).", "sources": [{"name": "Protocol_Ulcerative Colitis.pdf", "page": 13, "section": "Data Analyses", "exactText": "Safety analyses will be summarized descriptively by treatment groups. No statistical testing for comparison of treatment groups will be performed for safety variables.", "bboxes": [[72.0, 372.02398291015623, 531.72, 346.4949752178485]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 67, "section": "9.4.4 Safety Analysis Set", "exactText": "The Safety analysis set will include all randomised patients who received at least one dose of IMP, with treatment assignment according to actual treatment received.", "bboxes": [[72.0, 721.7039829101564, 549.12, 696.2949752178487]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 68, "section": "9.8.1 General Considerations", "exactText": "Safety parameters will be evaluated for the safety analysis data set. Complete data listings and summary tables will be created for all safety information and include adverse events, concomitant medications, vital signs, clinical laboratory test values, and 12-lead ECG. For safety data, Baseline will be defined as the last observed value collected prior to the start of treatment. No statistical testing for comparison of treatment groups will be performed for safety variables.", "bboxes": [[72.0, 124.58398291015624, 399.6, 114.29497521784856]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "embedding_ms": 227.07383398665115, "embedding_cache_hit": false, "semantic_cache_search_ms": 228.33737498149276, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 44, "confidence_filter_kept_count": 44, "confidence_filter