2026-07-30 11:57:44,677 - rag_service.services.generation_service - INFO - {"event": "rag_query_trace", "query": "Q2W dosing schedule", "system_prompt_version": "a0b9615a", "retrieved_chunks": [{"title": "Protocol_Ulcerative Colitis.pdf", "page": 45, "section": "Table 1 Time and Events Schedule", "score": null, "scores": [0.01639344262295082, 0.014492753623188406, 0.014285714285714285, 0.0125]}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 8, "section": "Study Design", "score": 0.016129032258064516, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 31, "section": "3.4.4 Selection of Doses in the Trial", "score": 0.015873015873015872, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 37, "section": "4.3.3 Other Restrictions", "score": 0.015625, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 26, "section": "3.1.2 Overall Design", "score": null, "scores": [0.015384615384615385, 0.012987012987012988]}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 50, "section": "6.2.4 12-week Treatment Period (Visits 3 to 8)", "score": 0.015151515151515152, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 44, "section": "Table 1 Time and Events Schedule", "score": 0.014925373134328358, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 32, "section": "3.4.5 Selection and Timing of Dose for Each Patient", "score": 0.014705882352941176, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 33, "section": "3.4.5 Selection and Timing of Dose for Each Patient", "score": 0.014084507042253521, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 92, "section": "Appendix 4 - Summary of Changes for Version 1.1", "score": 0.013888888888888888, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 9, "section": "Study Flowchart", "score": 0.0136986301369863, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 25, "section": "Secondary Endpoints", "score": 0.013513513513513514, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 7, "section": "Secondary Endpoints", "score": 0.013333333333333334, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 51, "section": "6.2.5 PK Visits", "score": 0.013157894736842105, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 66, "section": "9.1 Determination of Sample Size", "score": 0.01282051282051282, "scores": null}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 12, "section": "Sample Size", "score": 0.012658227848101266, "scores": null}], "context_char_count": 14733, "response": "## Q2W Dosing Schedule for TJ301\n\n### Treatment Arms\nPatients are randomized 1:1:1 to one of three groups (Protocol_Ulcerative Colitis.pdf, p. 8):\n- **600 mg TJ301 Q2W**\n- **300 mg TJ301 Q2W**\n- **Placebo Q2W**\n\n### Dosing Days\nTJ301 or placebo administrations occur on **Days 0, 14, 28, 42, 56, and 70**, totaling **6 doses** over the 12-week Treatment Period (Protocol_Ulcerative Colitis.pdf, p. 8).\n\n### Dose Selection Rationale\n- The **300 mg and 600 mg Q2W** doses are anticipated to suppress IL-6/sIL-6R second messenger signal STAT-3 to baseline, with trough levels expected to be >1 \u00b5g/mL (Protocol_Ulcerative Colitis.pdf, p. 31).\n- The **600 mg dose** is selected to cover the highest anticipated dose in the therapeutic range of TJ301 (Protocol_Ulcerative Colitis.pdf, p. 31).\n- The **75 mg Q2W** dose (not included in the trial) was simulated to suppress the second messenger signal for at least one week, with ~80% occupancy after 14 days (Protocol_Ulcerative Colitis.pdf, p. 31).\n\n### Fixed Dosing\nDosing is **fixed-dose throughout the trial**, administered as infusions every 2 weeks by trial personnel at the trial site (Protocol_Ulcerative Colitis.pdf, p. 32).\n\n### Dose Safety Basis\nThe maximum dose of 600 mg Q2W is considered safe and tolerable based on the phase I study, where the maximum dose was 600 mg **weekly** for 4 consecutive weeks. The concentration-time curves indicated very limited accumulation of TJ301 in plasma after multiple dosing (Protocol_Ulcerative Colitis.pdf, p. 32).", "sources": [{"name": "Protocol_Ulcerative Colitis.pdf", "page": 8, "section": "Study Design", "exactText": "90 patients will be centrally, dynamically, randomly assigned to 3 groups (1:1:1) to receive 600mg TJ301 biweekly (Q2W), 300mg TJ301 Q2W or placebo Q2W. TJ301 or placebo administrations will occur on Days 0, 14, 28, 42, 56, and 70.", "bboxes": [[72.0, 732.3839829101563, 472.56, 722.0949752178486]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 31, "section": "3.4.4 Selection of Doses in the Trial", "exactText": "Both the 300 mg and 600 mg dose administered every other week are anticipated to suppress the activation of the IL-6/sIL-6R second messenger signal STAT-3 to baseline, as the trough levels are expected to be >1 \u00b5g/mL. The highest dose of 600 mg is selected to likely cover the highest anticipated dose in the therapeutic range of TJ301.", "bboxes": [[71.9999999999996, 399.0239829101561, 549.1199999999995, 297.65497521784835]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 32, "section": "3.4.5 Selection and Timing of Dose for Each Patient", "exactText": "During the 12-week Treatment Period, dosing will be infusions every 2 weeks, as administered by trial personnel at the trial site. Dosing is fixed-dose throughout the trial.", "bboxes": [[72.0, 302.9039829101562, 546.12, 277.4949752178485]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 32, "section": "3.4.5 Selection and Timing of Dose for Each Patient", "exactText": "In the multiple dosing parts of the phase I study of TJ301, the maximum dose of TJ301 was set as 600 mg weekly for 4 consecutive weeks (4 doses totally). In this study, TJ301 will be administered at up to 600 mg every two weeks for 12 consecutive weeks (6 doses totally).", "bboxes": [[72.0, 302.9039829101562, 546.12, 277.4949752178485]], "relevance": "medium"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 26, "section": "3.1.2 Overall Design", "exactText": "90 patients will be centrally, dynamically, randomly assigned to 3 groups (1:1:1) to receive 600mg TJ301 biweekly (Q2W), 300mg TJ301 Q2W or placebo Q2W. Randomisation will be stratified by prior corticosteroids treatment (yes/no) and consent to participate in PK substudy (yes/no). TJ301 or placebo administrations will occur on Days 0, 14, 28, 42, 56, and 70.", "bboxes": [[72.0, 603.5039829101565, 518.28, 593.2149752178489], [89.99999999999989, 225.47998291015642, 541.6799999999998, 214.73497521784873]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "embedding_ms": 260.8714589732699, "embedding_cache_hit": false, "semantic_cache_search_ms": 228.9897910086438, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 20, "confidence_filter_kept_count": 20, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.4752, 0.461, 0.4547, 0.4452, 0.4426, 0.4379, 0.4365, 0.4355, 0.4292, 0.4282, 0.4257, 0.423, 0.4228, 0.4212, 0.4202, 0.4199, 0.419, 0.4189, 0.4182, 0.4157], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 538.0007079802454, "hybrid_parallel_ms": 740.7670000102371, "vector_count": 20, "bm25_count": 0, "fused_count": 20, "retrieval_total_ms": 740.8981670159847}, "original_chunk_count": 20, "compression_ms": 0.11991598876193166, "compressed_chunk_count": 16, "llm_call_ms": 24967.167792026885, "generation_total_ms": 26632.9595829593}}
