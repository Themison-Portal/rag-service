2026-07-29 09:15:17,577 - rag_service.services.generation_service - INFO - {"event": "rag_query_trace", "query": "What safety analyses are planned?", "retrieved_chunks": [{"title": "Protocol_Ulcerative Colitis.pdf", "page": 14, "section": "Data Analyses"}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 68, "section": "9.8.1 General Considerations"}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 13, "section": "Data Analyses"}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 67, "section": "9.4.4 Safety Analysis Set"}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 66, "section": "9 STATISTICAL METHODS"}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 29, "section": "3.3 Safety Review Committee"}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 15, "section": "Data Analyses"}, {"title": "Protocol_Ulcerative Colitis.pdf", "page": 16, "section": "Protocol No.: CTJ301UC201"}], "context_char_count": 7931, "response": "## Planned Safety Analyses\n\n### 1. Safety Analysis Set\nThe Safety Analysis Set includes **all randomised patients who received at least one dose of IMP**, with treatment assignment according to actual treatment received (Protocol_Ulcerative Colitis.pdf, p. 67).\n\n### 2. Descriptive Summaries\nSafety analyses will be **summarised descriptively by treatment groups**. No statistical testing for comparison of treatment groups will be performed for safety variables (Protocol_Ulcerative Colitis.pdf, p. 13).\n\n### 3. Safety Parameters Evaluated\nComplete data listings and summary tables will be created for all safety information, including:\n- **Adverse events**\n- **Concomitant medications**\n- **Vital signs**\n- **Clinical laboratory test values**\n- **12-lead ECG**\n\n(Protocol_Ulcerative Colitis.pdf, p. 68)\n\n### 4. Baseline Definition\nFor safety data, **Baseline is defined as the last observed value collected prior to the start of treatment** (Protocol_Ulcerative Colitis.pdf, p. 68).\n\n### 5. Statistical Analysis Plan (SAP)\nAll statistical analyses will be detailed in a **separate Statistical Analysis Plan (SAP)** (Protocol_Ulcerative Colitis.pdf, p. 66).\n\n### 6. Safety Review Committee (SRC)\nA **Safety Review Committee (SRC)** will be established to periodically review cumulative safety data at regular intervals. The SRC will:\n- Review **blinded data**\n- Evaluate safety concerns\n- Make recommendations to the Sponsor regarding trial conduct and possible modifications\n- Comprise at least a **medical monitor, a physician, and a pharmacologist**\n\nA SRC Working Procedure will be prepared and signed prior to enrolment of the first patient (Protocol_Ulcerative Colitis.pdf, p. 29).", "sources": [{"name": "Protocol_Ulcerative Colitis.pdf", "page": 67, "section": "9.4.4 Safety Analysis Set", "exactText": "The Safety analysis set will include all randomised patients who received at least one dose of IMP, with treatment assignment according to actual treatment received.", "bboxes": [[72.0, 721.7039829101564, 549.12, 696.2949752178487]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 13, "section": "Data Analyses", "exactText": "Safety analyses will be summarized descriptively by treatment groups. No statistical testing for comparison of treatment groups will be performed for safety variables.", "bboxes": [[72.0, 372.02398291015623, 531.72, 346.4949752178485]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 68, "section": "9.8.1 General Considerations", "exactText": "Complete data listings and summary tables will be created for all safety information and include adverse events, concomitant medications, vital signs, clinical laboratory test values, and 12-lead ECG.", "bboxes": [[72.0, 124.58398291015624, 399.6, 114.29497521784856]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 68, "section": "9.8.1 General Considerations", "exactText": "For safety data, Baseline will be defined as the last observed value collected prior to the start of treatment. No statistical testing for comparison of treatment groups will be performed for safety variables.", "bboxes": [[72.0, 124.58398291015624, 399.6, 114.29497521784856]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 66, "section": "9 STATISTICAL METHODS", "exactText": "All statistical analyses will be detailed in a separate Statistical Analysis Plan (SAP).", "bboxes": [[71.99999999999997, 715.7039829101564, 477.96, 705.4149752178487]], "relevance": "high"}, {"name": "Protocol_Ulcerative Colitis.pdf", "page": 29, "section": "3.3 Safety Review Committee", "exactText": "A Safety Review committee (SRC) will be established. The SRC is an expert advisory group commissioned and charged with the responsibility of evaluating, primarily, cumulative safety data at regular intervals. The SRC will review blinded data and provide recommendations to the Sponsor based on their evaluation.", "bboxes": [[72.0, 579.2639829101564, 555.24, 523.3749752178487]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "embedding_ms": 242.120042006718, "embedding_cache_hit": false, "semantic_cache_search_ms": 226.70491700409912, "retrieval": {"chunk_cache_hit": false, "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 371.7458750179503, "hybrid_parallel_ms": 568.9941660093609, "vector_count": 20, "bm25_count": 0, "fused_count": 19, "retrieval_total_ms": 569.2063329915982}, "original_chunk_count": 19, "compression_ms": 0.2022090193349868, "compressed_chunk_count": 8, "llm_call_ms": 14694.282957992982, "generation_total_ms": 16161.750416998984}}
