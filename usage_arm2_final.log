ients", "exactText": "In total, 90 patients with active UC at approximately 25-30 investigational sites globally will be enrolled competitively and randomised equally into three arms with TJ301 (two dose levels) or placebo.", "bboxes": [[72.0, 653.5439829101564, 534.48, 612.8949752178487]], "relevance": "medium"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.003459397703409195, "query_condensed": false, "embedding_ms": 761.2432078458369, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.4428, 0.3965, 0.3937, 0.3897, 0.3745, 0.3724, 0.3712, 0.3635, 0.3614, 0.3533, 0.3472, 0.3467, 0.3429, 0.3416, 0.3413, 0.341, 0.3408, 0.3389, 0.3375, 0.3341, 0.3335, 0.3325, 0.3317, 0.3313, 0.3313, 0.3304, 0.3289, 0.3285, 0.3279, 0.3275, 0.3269, 0.3254, 0.3249, 0.3246, 0.3235, 0.3227, 0.3224, 0.3204, 0.3203, 0.3198, 0.3197, 0.3192, 0.3188, 0.3179, 0.3176], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5507.245250046253, "hybrid_parallel_ms": 5914.261457975954, "vector_count": 45, "bm25_count": 0, "fused_count": 45, "reranker_enabled": true, "reranker_provider": "cohere", "reranker_ms": 344.8009588755667, "reranker_input_count": 45, "reranker_output_count": 6, "reranker_model": "rerank-english-v3.0", "retrieval_total_ms": 6280.864959117025}, "original_chunk_count": 6, "compression_ms": 0.294374767690897, "compressed_chunk_count": 5, "llm_call_ms": 6470.813708845526, "provider": "openai", "model": "gpt-5.6-terra", "generation_total_ms": 13515.17133275047}}
