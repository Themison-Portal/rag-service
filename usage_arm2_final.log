INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "What is the molecular mechanism of action of TJ301?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 23, "section": "1.1 Background", "score": 0.9851576, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 29, "section": "3.4.1 Trial Design", "score": 0.9722044, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 22, "section": "1.1 Background", "score": 0.9313377, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 6, "section": "Secondary Objectives", "score": 0.7192851, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 96, "section": "Appendix 4 - Summary of Changes for Version 1.1", "score": 0.692538, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 1, "section": "A Phase II, Randomized, Double-blind, Placebo-controlled Study to Evaluate the Safety and Efficacy of TJ301 (FE 999301) Administered Intravenously in Patients with Active Ulcerative Colitis", "score": 0.6772606, "scores": null, "had_context": true}], "context_char_count": 7423, "response": "Source: Protocol Ulcerative Colitis\n\nTJ301 (FE 999301; olamkicept) is a first-in-class selective IL-6 trans-signalling inhibitor. It acts as a selective IL-6/sIL-6R complex trap composed of two complete extracellular domains of gp130, dimerised by fusion to the Fc region of human IgG1. It targets and neutralises the IL-6/sIL-6R complex, inhibiting IL-6 trans-signalling without interacting with IL-6 or IL-6R individually; unlike other anti-IL-6 or anti-IL-6R products, it does not block both IL-6 signalling pathways.\n[Section 1.1 Background \u00b7 p.22]\n[Section 1.1 Background \u00b7 p.23]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 22, "section": "1.1 Background", "exactText": "TJ301 (FE 999301, Olamkicept (proposed INN)) is a first-in-class, selective IL-6 trans-signalling inhibitor and anti-inflammatory biologic that is under development for the treatment of UC and Crohn's disease. TJ301 is a selective IL-6/sIL-6R complex trap consisting of two complete extracellular domains of gp130, the common signal transducer of IL-6-type cytokines, dimerised by", "bboxes": [[72.00000000000006, 229.82398291015625, 551.3999999999997, 174.05497521784855]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 23, "section": "1.1 Background", "exactText": "fusion to the fragment crystallisable region (Fc region) of human immunoglobulin G1 (IgG1). TJ301 targets and neutralises the IL-6/sIL-6R complex thereby inhibiting the trans -signalling pathway, without any interaction with either IL-6 or IL-6R individually, which is different from other anti-IL6 or anti-IL6R products in development to block IL-6 two signaling pathways.", "bboxes": [[71.99999999999989, 738.5039829101562, 553.0799999999999, 652.3749752178485]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": false, "condense_ms": 0.0007082708179950714, "query_condensed": false, "embedding_ms": 638.7798748910427, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 43, "confidence_filter_kept_count": 43, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.6343, 0.5552, 0.676, 0.6697, 0.6441, 0.6441, 0.615, 0.6105, 0.6015, 0.5958, 0.5921, 0.592, 0.5913, 0.5854, 0.5844, 0.5809, 0.5767, 0.5765, 0.5715, 0.5709, 0.5668, 0.566, 0.5657, 0.5638, 0.5574, 0.5573, 0.5572, 0.5559, 0.5552, 0.5539, 0.5539, 0.5533, 0.549, 0.5436, 0.5432, 0.5425, 0.5402, 0.5401, 0.5398, 0.5358, 0.5358, 0.534, 0.5318],