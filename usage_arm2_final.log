INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "What is the dosing schedule of the study drug?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 68, "section": "9.7 Extent of Exposure and Treatment Compliance", "score": 0.65555656, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 30, "section": "3.4.4 Selection of Doses in the Trial", "score": 0.44489637, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 32, "section": "3.4.5 Selection and Timing of Dose for Each Patient", "score": 0.31320965, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 31, "section": "3.4.4 Selection of Doses in the Trial", "score": 0.3106944, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 9, "section": "Study Flowchart", "score": 0.22746934, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 45, "section": "Table 1 Time and Events Schedule", "score": 0.14342749, "scores": null, "had_context": true}], "context_char_count": 7131, "response": "Source: Protocol Ulcerative Colitis\n\nDuring the 12-week Treatment Period, TJ301 is administered by intravenous infusion every 2 weeks at the trial site by trial personnel. Dosing is fixed-dose throughout the trial. The dose levels described are 75 mg, 300 mg, and 600 mg every other week; the maximum regimen is 600 mg every 2 weeks for 12 consecutive weeks (6 doses total).\n[Section 3.4.5 Selection and Timing of Dose for Each Patient \u00b7 p.32]\n\nThe 75 mg, 300 mg, and 600 mg doses are each described as administered every other week.\n[Section 3.4.4 Selection of Doses in the Trial \u00b7 p.31]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 32, "section": "3.4.5 Selection and Timing of Dose for Each Patient", "exactText": "During the 12-week Treatment Period, dosing will be infusions every 2 weeks, as administered by trial personnel at the trial site. Dosing is fixed-dose throughout the trial.\n\nIn the multiple dosing parts of the phase I study of TJ301, the maximum dose of TJ301 was set as 600 mg weekly for 4 consecutive weeks (4 doses totally). In this study, TJ301 will be administered at up to 600 mg every two weeks for 12 consecutive weeks (6 doses totally).", "bboxes": [[72.0, 302.9039829101562, 546.12, 277.4949752178485]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 31, "section": "3.4.4 Selection of Doses in the Trial", "exactText": "The 75 mg dose every other week is, according to simulations, anticipated to suppress the second messenger signal to baseline level for a duration of at least one week and single dose data suggest appro ximately 80% occupancy after 14 days (Figure 3b). Both the 300 mg and 600 mg dose administered every other week are anticipated to suppress the activation of the IL-6/sIL-6R second messenger signal STAT-3 to baseline, as the trough levels are expected to be >1 \u00b5g/mL.", "bboxes": [[71.9999999999996, 399.0239829101561, 549.1199999999995, 297.65497521784835]], "relevance": "high"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": false, "condense_ms": 0.005709007382392883, "query_condensed": false, "embedding_ms": 709.6554171293974, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 45, "confidence_filter_kept_count": 45, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.5972, 0.5521, 0.544, 0.5427, 0.5406, 0.5356, 0.5277, 0.5215, 0.521, 0.5192, 0.5184, 0.5184, 0.5124, 0.5123, 0.5084, 0.5064, 0.503, 0.4999, 0.4986, 0.4984, 0.4981, 0.4963, 0.496, 0.4954, 0.4931, 0.4925, 0.4888