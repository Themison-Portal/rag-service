INFO     rag_service.services.generation_service:generation_service.py:427 {"event": "rag_query_trace", "query": "(1) How is the drug dosed?", "retrieval_query": null, "system_prompt_version": "440b2406", "retrieved_chunks": [{"title": "Protocol Ulcerative Colitis", "page": 31, "section": "3.4.4 Selection of Doses in the Trial", "score": 0.19744445, "scores": null, "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 30, "section": "3.4.4 Selection of Doses in the Trial", "score": null, "scores": [0.058776557, 0.058776557], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 39, "section": "5.1 Treatments Administered", "score": null, "scores": [0.041930523, 0.027376488], "had_context": true}, {"title": "Protocol Ulcerative Colitis", "page": 32, "section": "3.4.4 Selection of Doses in the Trial", "score": 0.016529556, "scores": null, "had_context": true}], "context_char_count": 6818, "response": "Source: Protocol Ulcerative Colitis\n\nTJ301 is administered by intravenous infusion. The trial uses two active dose groups\u2014300 mg and 600 mg\u2014and a placebo group. Both TJ301 and placebo are diluted in 250 mL of 5% (w/v) glucose; resulting TJ301 concentrations are 1.03 mg/mL for the 300 mg group, 2.07 mg/mL for the 600 mg group, and 0 mg/mL for placebo. The infusion time is 2 hours.\n[Section 5.1 Treatments Administered \u00b7 p.39]\n\nThe selected 300 mg and 600 mg doses were intended to produce exposure above the theoretical full-target-saturation threshold of 1 \u00b5g/mL at trough.\n[Section 3.4.4 Selection of Doses in the Trial \u00b7 p.32]", "sources": [{"name": "Protocol Ulcerative Colitis", "page": 39, "section": "5.1 Treatments Administered", "exactText": "Both placebo and TJ301 should be stored at -20 \u00b1 5\u00b0C and thawed at the site by site personnel (blind to study randomisation) and diluted in  250 mL 5% (w/v) glucose (1.03 mg/mL TJ301 for the 300 mg group, 2.07 mg/mL TJ301 for the 600 mg group and 0 mg/mL TJ301 for the placebo group ). The infusion time is 2 hours.", "bboxes": [[71.99999999999997, 689.9039829101564, 523.8, 664.4949752178487], [71.99999999999994, 459.52798291015654, 201.59999999999994, 448.9749752178488]], "relevance": "high"}, {"name": "Protocol Ulcerative Colitis", "page": 32, "section": "3.4.4 Selection of Doses in the Trial", "exactText": "The two doses are selected to give exposure above (300 and 600 mg) full target saturation (expected at the theoretical threshold of 1 \u00b5g/mL at trough).", "bboxes": [[71.99999999999994, 422.7839829101563, 552.8399999999997, 336.6549752178485]], "relevance": "medium"}], "timing": {"response_cache_hit": false, "semantic_cache_hit": false, "chunks_compressed": true, "condense_ms": 0.0007920898497104645, "query_condensed": false, "embedding_ms": 700.3634576685727, "embedding_cache_hit": false, "retrieval": {"chunk_cache_hit": false, "confidence_filter_applied": true, "confidence_filter_threshold": 0.04, "confidence_filter_bm25_threshold": null, "confidence_filter_input_count": 47, "confidence_filter_kept_count": 47, "confidence_filter_dropped_count": 0, "confidence_filter_kept_scores": [0.4613, 0.4321, 0.4272, 0.4257, 0.4248, 0.4204, 0.4204, 0.4177, 0.4174, 0.4148, 0.413, 0.4117, 0.411, 0.4109, 0.4092, 0.4087, 0.4061, 0.4039, 0.4019, 0.4014, 0.4, 0.3953, 0.3928, 0.3919, 0.3915, 0.3904, 0.388, 0.3875, 0.3853, 0.3851, 0.3839, 0.3829, 0.3819, 0.3807, 0.3807, 0.3805, 0.3796, 0.3787, 0.3782, 0.3724, 0.3721, 0.3712, 0.3712, 0.3694, 0.369], "confidence_filter_dropped_scores": [], "confidence_filter_bm25_only_scores_normalized": [1.0, 0.0], "hybrid_search": true, "cache_hit": true, "embedding_ms": 0.0, "db_search_ms": 5645.61124984175, "hybrid_parallel_ms": 6055.729332845658, "vector_count": 45, "bm25_count": 2, "fused_count": 47, "reranker_enabled": true, "reranker_provider": "cohere", "reranker_ms": 363.14808297902346, "reranker_input_count": 47, "reranker_output_count": 6, "reranker_model": "rerank-english-v3.0", "retri